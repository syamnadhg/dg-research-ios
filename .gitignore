__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.DS_Store

# B0a / substrate run artifacts — captured DOM, screenshots, IWDP logs.
artifacts/
*.log

# Never commit credentials or the Firebase iOS config (it carries an API key).
GoogleService-Info.plist
*.mobileprovision
*.p8
*.p12
secrets/

# Xcode
ios/**/xcuserdata/
ios/**/*.xcworkspace/xcuserdata/
DerivedData/

# Swift
ios/.build/
ios/.swiftpm/
artifacts/apphost/
artifacts/app/

# SwiftPM build trees. `ios/FirebaseGlue` resolves the Firebase SDK plus 14 transitive
# dependencies — 1.3 GB, including prebuilt gRPC and abseil binaries. That resolution is also the
# evidence for choosing REST over the SDK: pulling it in means adopting an Xcode project, since a
# hand-built .app cannot link those binary frameworks or their resource bundles.
.build/
Package.resolved
